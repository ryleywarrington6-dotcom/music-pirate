{
  "name": "Infinite Radio",
  "comment": "Endless mix of liked or high-play tracks, excluding skipped ones",
  "searchRules": {
    "all": [
      { "operator": "is", "field": "skipCount", "value": ["0"] },
      {
        "any": [
          { "operator": "is", "field": "loved", "value": ["true"] },
          { "operator": "gt", "field": "playCount", "value": ["3"] }
        ]
      }
    ]
  },
  "sort": "random",
  "limit": 100
}
